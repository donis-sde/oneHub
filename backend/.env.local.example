# Copy to app/.env.local and fill in real values:
#   cp .env.local.example app/.env.local

NODE_ENV=development
NODE_APP_INSTANCE=local

# Required - core app
JWT_SECRET=change-me-local-dev-secret
DB_URL=mongodb://127.0.0.1:27017
TENANTS_DATABASE=wati-tenants
MT_DB_NAME=wati-tenants
GCP_PROJECT_ID=local-dev

# Auth / admin collections
NEXT_PUBLIC_DB_AUTH_DATABASE=wati-admin
NEXT_PUBLIC_DB_AUTH_ADMIN_USER_COLLECTION=AdminUsers
NEXT_PUBLIC_DB_TENANT_TENANT_COLLECTION=Tenants
NEXT_PUBLIC_DB_AUTH_COLUMN_ACCESS_SETTING_COLLECTION=ColumnAccessSettings
NEXT_PUBLIC_DB_AUTH_TABLE_ACCESS_SETTING_COLLECTION=TableAccessSettings
NEXT_PUBLIC_DB_TENANT_CONTACT_COLLECTION=Contacts
NEXT_PUBLIC_DB_AUTH_CONTACT_ACTIVITY_LOG_COLLECTION=ContactActivityLogs
NEXT_PUBLIC_DB_AUTH_CREATE_USER_LOG_COLLECTION=CreateUserLogs
NEXT_PUBLIC_DB_AUTH_TERMINATE_SUBSCRIPTION_LOG_COLLECTION=TerminateSubscriptionLogs
NEXT_PUBLIC_FB_WABA_ID=000000000000000

# Facebook / Meta
FB_VERSION=v21.0
FB_SYSTEM_TOKEN=replace-me
FB_TOKEN=replace-me
CLARE_SECRET_KEY=replace-me

# Partner / settings
PARTNER_DB_DATABASE=Partners
PARTNER_DB_COLLECTION=Partners
MT_SETTING_COLLECTION_NAME=Settings
MT_USER_COLLECTION_NAME=Users
TRANSACTION_DB_COLLECTION=Transactions
BACOFFICE_DB_UPDATE_LOGS_COLLECTION=BackofficeDbUpdateLogs
BACKOFFICE_FEATURE_ACCESS_CONTROL_COLLECTION=FeatureAccessControl

# Log collections
NEXT_PUBLIC_DB_AUTH_CLEAN_CACHE_LOG_COLLECTION=CleanCacheLogs
NEXT_PUBLIC_DB_AUTH_STOP_BROADCAST_LOG_COLLECTION=StopBroadcastLogs
NEXT_PUBLIC_DB_AUTH_GET_BMID_LOG_COLLECTION=GetBmidLogs
NEXT_PUBLIC_DB_AUTH_GET_PHONE_NUM_LOG_COLLECTION=GetPhoneNumLogs
NEXT_PUBLIC_DB_AUTH_REG_PHONE_NUM_LOG_COLLECTION=RegPhoneNumLogs
NEXT_PUBLIC_DB_AUTH_REMOVE_CREDIT_LINE_LOG_COLLECTION=RemoveCreditLineLogs
NEXT_PUBLIC_DB_AUTH_GET_OTP_LOG_COLLECTION=GetOtpLogs

# Optional services (only needed for specific features)
LOG_LEVEL=debug
BILLING_DB_URL=mongodb://127.0.0.1:27017
BILLING_DATABASE=wati-billing
AUDIT_LOG_DATABASE=wati-audit
PRICING_DB_URL=mongodb://127.0.0.1:27017
PRICING_DATABASE=wati-pricing
PRM_GATEWAY_DB_USER=root
PRM_GATEWAY_DB_PASSWORD=password
PRM_GATEWAY_DB_HOST=127.0.0.1
PRM_GATEWAY_DB_PORT=3306
PRM_GATEWAY_DB_NAME=prm_gateway
RETOOL_API_KEY=replace-me
PARTNERSHIP_SERVICE_URL=http://localhost:4000
WATI_MT_SERVER_URL=http://localhost:5000
WATI_BE_SERVER_URL_API_KEY=replace-me

# Astra Postgres — Astra Tools only (read-only allowlist)
# Databases: astra-insight-mcp, cloudsqladmin, dify, postgres,
# prod-astra-account-service, prod-astra-ai-benchmark, prod-astra-api-service,
# prod-astra-composio-mcp, prod-astra-integration, prod-astra-mapping-service,
# prod-astra-metrics, prod-astra-usage-service, prod_dify, prod_dify_plugin
ASTRA_DB_HOST=
ASTRA_DB_USER=
ASTRA_DB_PASS=
ASTRA_DB_PORT=5432
ASTRA_USAGE_DB_NAME=prod-astra-usage-service
